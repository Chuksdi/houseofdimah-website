---
const links = [
  { href: '/#services', label: 'Services' },
  { href: '/#method', label: 'How we work' },
  { href: '/#work', label: 'Client stories' },
  { href: '/#prices', label: 'Prices' },
];
---
<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <button class="pill close" type="button" data-menu-toggle>Close</button>
  {links.map((l) => <a href={l.href} data-menu-link>{l.label}</a>)}
  <a href="/#contact" data-menu-link>Contact</a>
</div>

<header class="nav" id="nav">
  <nav class="wrap" aria-label="Main">
    <a class="logo" href="/" aria-label="House of Dimah, home">
      <img class="logo-d" src="/media/logo-white.png" alt="House of Dimah" width="88" height="82">
      <img class="logo-l" src="/media/logo-black.png" alt="House of Dimah" width="88" height="82">
    </a>
    <span class="sp"></span>
    {links.map((l) => <a class="lnk" href={l.href}>{l.label}</a>)}
    <button class="pill" type="button" data-mode-toggle aria-label="Switch light and dark mode">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path></svg>
      <span data-mode-label>Light</span>
    </button>
    <a class="btn" href="/#start">Start here</a>
    <button class="pill" type="button" data-menu-toggle aria-controls="menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6h12"></path><path d="M10 12h9"></path><path d="M3 18h17"></path></svg>
      Menu
    </button>
  </nav>
</header>
