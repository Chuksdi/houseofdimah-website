---
// The site footer for the client story pages (they use CaseLayout, which has no site.css):
// Brand / Content / Execution, the logo, Say hello and the © line. Same look as the main footer.
import { getContent } from '../lib/content';
const { settings: SITE, services } = await getContent(Astro.locals);
import { SITE as STATIC } from '../data/site';
const L = STATIC.legal;
const li = '<svg viewBox="2.76 2.78 18.2 18.2" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"></path></svg>';
const ig = '<svg viewBox="2.1 2.1 19.8 19.8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"></circle></svg>';
---
<footer class="cf">
  <div class="cf-wrap cf-three">
    <div><h2>Brand</h2><p>Story, identity and guidelines your team can use.</p></div>
    <div><h2>Content</h2><p>Photo, video, social and websites, on a rhythm that fits.</p></div>
    <div><h2>Execution</h2><p>Digital experiences and strategic narrative. Built, launched and kept running.</p></div>
  </div>
  <div class="cf-bottom">
    <a class="cf-logo" href="/"><img src="/media/logo-white.png" alt="House of Dimah" width="260" height="240" loading="lazy"></a>
    <div class="cf-cols">
    <nav class="cf-col" aria-label="Footer">
      <p class="cf-head">Explore</p>
      {STATIC.footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="cf-col">
      <p class="cf-head">Services</p>
      {services.map((s) => <a href={`/services/${s.slug}/`}>{s.name}</a>)}
    </div>
    <div class="cf-contact">
      <p class="cf-head">Say hello</p>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={`tel:${STATIC.phoneIntl}`}>{STATIC.phone}</a>
      <span>{SITE.areas.join(' · ')}</span>
      {(SITE.instagram || SITE.linkedin) && <span class="cf-soc">{SITE.linkedin && <a href={SITE.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Fragment set:html={li} /></a>}{SITE.instagram && <a href={SITE.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Fragment set:html={ig} /></a>}</span>}
    </div>
    </div>
  </div>
  <div class="cf-fine">
    <span class="cf-links"><a href="/privacy/">Privacy notice</a><a href="/terms/">Website terms</a><a href="/privacy/#cookies">Cookies</a></span>
    <span class="cf-co">© 2026 {L.company}. Registered in England and Wales, company number {L.companyNumber}. Registered office: {L.registeredOffice}.</span>
  </div>
</footer>

<style>
  .cf{background:#050505;color:rgba(246,250,254,.8);font-family:"Saira","Helvetica Neue",Arial,sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
  .cf *{box-sizing:border-box}
  .cf a{color:rgba(246,250,254,.8);text-decoration:none}
  .cf a:hover{color:#F6FAFE}
  .cf p{margin:0}
  .cf-wrap{max-width:1100px;margin:0 auto}
  .cf-three{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;padding:56px clamp(20px,4vw,72px) 110px;border-top:1px solid rgba(246,250,254,.14);border-bottom:1px solid rgba(246,250,254,.14)}
  .cf h2{font-family:"Funnel Display","Helvetica Neue",Arial,sans-serif;font-weight:800;letter-spacing:-.025em;font-size:22px;color:#F6FAFE;margin:0 0 6px}
  .cf-three p{font-size:14px;max-width:30ch}
  .cf-bottom{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:28px;padding:40px clamp(20px,3vw,40px) 36px}
  .cf-logo{display:block;width:260px;height:240px;position:relative}
  .cf-logo img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:left bottom}
  .cf-contact{display:grid;gap:4px;font-size:14px;text-align:right}
  .cf-head{font-size:10.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:rgba(246,250,254,.55);margin-bottom:6px!important}
  .cf-soc{display:flex;justify-content:flex-end;gap:14px;margin-top:6px}
  .cf-soc a{display:inline-grid;place-items:center;width:28px;height:28px}
  .cf-soc :global(svg){width:22px;height:22px}
  .cf-fine{border-top:1px solid rgba(246,250,254,.14);padding:16px clamp(20px,4vw,72px);font-size:12px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 28px}
  .cf-links{display:flex;flex-wrap:wrap;gap:8px 28px}
  .cf-co{color:rgba(246,250,254,.55)}
  .cf-cols{display:flex;flex-wrap:wrap;align-items:flex-start;gap:28px 56px}
  .cf-col{display:grid;gap:4px;font-size:14px;align-content:start}
  .cf-col .cf-head{margin:0 0 6px}
  @media (max-width:860px){.cf-three{grid-template-columns:minmax(0,1fr)}.cf-contact{text-align:left}.cf-soc{justify-content:flex-start}.cf-logo{width:180px;height:166px}.cf-cols{gap:28px 40px}}
</style>
