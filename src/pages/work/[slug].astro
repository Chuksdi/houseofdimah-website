---
import CaseLayout from '../../layouts/CaseLayout.astro';
import { getContent } from '../../lib/content';
import CASE_META from '../../data/cases/meta.json';
import tubScript from '../../scripts/case-tub.js?raw';
import countScript from '../../scripts/case-count.js?raw';

// Full stories, built from the Case boards on the Site Board (src/data/cases/<slug>.html + .css)
const caseHtml = import.meta.glob('../../data/cases/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const caseCss = import.meta.glob('../../data/cases/*.css', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

export async function getStaticPaths() {
  const { cases } = await getContent();
  return cases.map((c) => ({ params: { slug: c.slug } }));
}
const { cases } = await getContent(Astro.locals);
// look the story up per request too, so the preview site (rendered on demand) works
const c = cases.find((o) => o.slug === Astro.params.slug);
if (!c) return Astro.rewrite('/404/');
const slug = c.slug;
const body = caseHtml[`../../data/cases/${slug}.html`];
const css = caseCss[`../../data/cases/${slug}.css`];
const meta = (CASE_META as Record<string, { name: string; brief: string }>)[slug];
const title = `${meta?.name ?? c.name}: client story | House of Dimah`;
const description = meta?.brief || `How House of Dimah worked with ${c.name}: ${c.tags.join(' and ').toLowerCase()}.`;
const crumbs = [{ name: 'Client stories', path: '/#work' }, { name: c.name, path: `/work/${slug}/` }];
---
{body ? (
  <CaseLayout title={title} description={description} image={c.img} breadcrumbs={crumbs}>
    <style is:inline slot="head" set:html={css}></style>
    <main set:html={body} />
    {slug === 'british-chiropractic-association' && <script is:inline set:html={countScript}></script>}
    {slug === 'mr-strongmans' && <>
      <script is:inline src="/vendor/three/three.min.js"></script>
      <script is:inline src="/vendor/three/GLTFLoader.js"></script>
      <script is:inline src="/vendor/three/RoomEnvironment.js"></script>
      <script is:inline set:html={tubScript}></script>
    </>}
  </CaseLayout>
) : (
  <CaseLayout title={title} description={description} image={c.img} breadcrumbs={crumbs}>
    <style is:inline slot="head">{`body{margin:0;background:#0B0B0B;color:#F6FAFE;font-family:"Saira","Helvetica Neue",Arial,sans-serif}.fb{max-width:880px;margin:0 auto;padding:96px clamp(20px,4vw,72px);display:grid;gap:20px}.fb a{color:inherit}.fb h1{font-family:"Funnel Display","Helvetica Neue",Arial,sans-serif;font-weight:800;font-size:clamp(40px,6vw,80px);line-height:.95;margin:0}.fb img{width:100%;border-radius:6px}`}</style>
    <main class="fb">
      <p><a href="/">Home</a> / <a href="/#work">Client stories</a> / {c.name}</p>
      <h1>{c.name}</h1>
      <p>{c.tags.join(' · ')}</p>
      <img src={c.img} alt={c.alt} style={c.colour ? `background:${c.colour}` : undefined}>
      <p>{c.summary || 'The full story is on its way.'}</p>
      <p><a href="/#start">Start here</a></p>
    </main>
  </CaseLayout>
)}
