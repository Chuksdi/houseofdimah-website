---
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/content';

export async function getStaticPaths() {
  const { cases } = await getContent();
  return cases.map((c) => ({ params: { slug: c.slug } }));
}
const { cases } = await getContent(Astro.locals);
// look the story up per request too, so the preview site (rendered on demand) works
const c = cases.find((o) => o.slug === Astro.params.slug);
if (!c) return Astro.rewrite('/404/');
const title = `${c.name}: client story | House of Dimah`;
const description = `How House of Dimah worked with ${c.name}: ${c.tags.join(' and ').toLowerCase()}.`;
---
<Base title={title} description={description} breadcrumbs={[{ name: 'Client stories', path: '/#work' }, { name: c.name, path: `/work/${c.slug}/` }]}>
  <article class="inner">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/#work">Client stories</a> / <span aria-current="page">{c.name}</span></nav>
      <h1>{c.name}</h1>
      <p class="tags-line">{c.tags.join(' · ')}</p>
      <img class={`case-hero ${c.fit ? 'fit' : ''}`} src={c.img} alt={c.alt} style={c.colour ? `background:${c.colour}` : undefined}>
      {/* TODO: port the full case study from this client's Case board on the Site Board */}
      <p class="lede">{c.summary || 'The full story is on its way.'}</p>
      <a class="btn" href="/#start">Start here</a>
    </div>
  </article>
</Base>
