---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';

// The Brand Check: ten questions, a score out of 20, the fixes that matter, then an optional bespoke audit.
// Answers stay in the browser; only someone who asks for the audit sends anything (Netlify Forms, form "brand-audit").
const AREAS = { story: 'Story', brand: 'Brand', content: 'Content' } as const;
const Q: { area: keyof typeof AREAS; q: string; hint: string; fix: string }[] = [
  { area: 'story', q: 'Can you say what you do, for whom, in one sentence?', hint: 'Not a slogan. The sentence you would say to a stranger at a bus stop.', fix: 'Write it as "We help [who] [do what], in [where]." Test it on three customers and keep the version they repeat back.' },
  { area: 'story', q: 'Would your customers describe you the same way?', hint: 'Read your last five reviews. Do they praise the thing you think you are best at?', fix: 'Ask five regulars why they come back, and use their words on your website and in your bio.' },
  { area: 'brand', q: 'Do your logo, colours and fonts look the same everywhere?', hint: 'Shopfront, website, Instagram, menu or price list, invoices, van. Lay them side by side.', fix: 'List every place your logo appears and replace the odd ones out first, starting with the ones customers see most.' },
  { area: 'brand', q: 'Does your brand still look like the business you are today?', hint: 'If you have grown, moved upmarket or added a site since the logo was made, it may be holding you back.', fix: 'A refresh is not a rebrand. Keep what people recognise and modernise the rest.' },
  { area: 'content', q: "Does your website's first screen say what you do, where, and how to get in touch?", hint: 'Open it on your phone. Can you find all three without scrolling?', fix: 'Put one clear line and one button ("Book", "Call", "Order") at the top of the page.' },
  { area: 'content', q: 'Do you post on social media on a steady rhythm?', hint: 'Weekly and planned counts as yes. Bursts, then silence for weeks, counts as no.', fix: 'Pick a pace you can keep, even twice a week, and plan four weeks ahead.' },
  { area: 'content', q: 'Are your photos and videos of your real people, place and product?', hint: 'Stock images and phone snaps in bad light both tell people you are not quite sure of yourself.', fix: 'Book one proper shoot day. A good day of photos can last a whole season.' },
  { area: 'story', q: 'Does everything you write sound like the same person?', hint: 'Website, captions, emails and signs. Same warmth, same words, same level of formality.', fix: 'Write down five words for how you sound, and five you would never use. Share them with anyone who writes for you.' },
  { area: 'brand', q: "Can a new customer see proof that you're good within ten seconds?", hint: 'Reviews, testimonials, names of clients, before and after. Somewhere they will actually see it.', fix: 'Put your three best reviews on your homepage and pin one on Instagram.' },
  { area: 'content', q: "Do you know what you're posting next month, and why?", hint: 'A plan tied to what the business needs (a launch, a quiet season, a new service), and a way to see what worked.', fix: 'Start each month with one goal, and check at the end what moved it.' },
];
const title = 'Free Brand Check | House of Dimah';
const description = 'Ten questions that show where your brand is losing people, and what to fix first. Free, about ten minutes, with your score straight away.';
---
<Base title={title} description={description} breadcrumbs={[{ name: 'Brand Check', path: '/brand-check/' }]}>
  <article class="bc">
    <section class="wrap intro">
      <div>
        <h1>The Brand Check</h1>
        <p class="lede">Ten questions that show where your brand is losing people, and what to fix first.</p>
        <p class="meta"><span>About ten minutes</span><span>Your score straight away</span><span><i class="d story"></i>Story</span><span><i class="d brand"></i>Brand</span><span><i class="d content"></i>Content</span></p>
      </div>
      <a class="cover" href="/media/house-of-dimah-brand-check.pdf" target="_blank" rel="noopener"><img src="/media/brand-check-cover.jpg" alt="Cover of the printable Brand Check guide" width="480" height="679"></a>
    </section>

    <div class="prog"><div class="wrap"><div class="bar"><span id="bc-bar"></span></div><small id="bc-count">0 of 10 answered</small></div></div>

    <section class="wrap qs" aria-label="The ten questions">
      {Q.map((q, i) => (
        <fieldset class="q" data-q={i} data-area={q.area}>
          <legend class="sr">Question {i + 1}</legend>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <div><h2>{q.q}<i class={`d ${q.area}`} aria-hidden="true"></i></h2><p>{q.hint}</p></div>
          <div class="opts">
            <label class="opt"><input type="radio" name={`q${i}`} value="2"><span>Yes</span></label>
            <label class="opt"><input type="radio" name={`q${i}`} value="1"><span>Sometimes</span></label>
            <label class="opt"><input type="radio" name={`q${i}`} value="0"><span>No</span></label>
          </div>
        </fieldset>
      ))}
      <div class="see"><p id="bc-left">Answer all ten to see your score.</p><button class="btn" type="button" id="bc-show" aria-disabled="true">See my score</button></div>
    </section>

    <section class="res" id="result" hidden aria-live="polite">
      <div class="wrap">
        <div class="head">
          <p class="big"><span id="bc-score">0</span><small>/ 20</small></p>
          <div class="band"><h2 id="bc-band"></h2><p id="bc-band-text"></p></div>
        </div>
        <div class="areas">
          {Object.entries(AREAS).map(([k, name]) => (
            <div class="area"><div class="row"><span>{name}</span><span data-area-val={k}></span></div><div class="track"><span class={`d ${k}`} data-area-bar={k}></span></div></div>
          ))}
        </div>
        <div class="fixes">
          <h2 class="fh">What to fix first</h2>
          <p id="bc-fix-intro">Your no answers first, then the sometimes. One practical step for each.</p>
          <ol id="bc-fixes"></ol>
        </div>
      </div>
    </section>

    <section class="wrap audit" id="audit">
      <div>
        <h2 class="ah">Want a bespoke audit?</h2>
        <p class="lead">The Brand Check shows the shape of it. A bespoke audit shows the detail. We go through your brand ourselves and send back what we'd change first.</p>
        <ul>
          <li>We look at your website, social media and printed pieces</li>
          <li>A short written audit, specific to your business</li>
          <li>The three changes that would make the biggest difference</li>
          <li>Free, with an optional call to talk it through</li>
        </ul>
        <p class="pdf">Prefer it on paper? <a href="/media/house-of-dimah-brand-check.pdf" target="_blank" rel="noopener">Open the printable guide</a></p>
      </div>
      <form class="form" name="brand-audit" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" id="bc-form">
        <input type="hidden" name="form-name" value="brand-audit">
        <input type="hidden" name="score" id="bc-f-score" value="">
        <input type="hidden" name="answers" id="bc-f-answers" value="">
        <p hidden><label>Leave this empty <input name="bot-field"></label></p>
        <div class="scorechip"><span>Your Brand Check score</span><b id="bc-chip">Not taken yet</b></div>
        <div class="two">
          <div class="field"><label for="ba-name">Your name</label><input id="ba-name" name="name" type="text" autocomplete="name" required></div>
          <div class="field"><label for="ba-biz">Business</label><input id="ba-biz" name="business" type="text" autocomplete="organization" required></div>
        </div>
        <div class="field"><label for="ba-email">Email</label><input id="ba-email" name="email" type="email" autocomplete="email" required></div>
        <div class="field"><label for="ba-web">Website or Instagram</label><input id="ba-web" name="website" type="text" placeholder="yourbusiness.co.uk or @yourbusiness"></div>
        <div class="field"><label for="ba-note">Anything you'd like us to look at first? (optional)</label><textarea id="ba-note" name="note"></textarea></div>
        <button class="btn" type="submit">Request my audit</button>
        <small>Chuks or Kat will do it themselves, within five working days. No spam.</small>
      </form>
      <div class="form thanks" id="bc-thanks" hidden role="status">
        <h2 class="th">Thanks. Your audit is on its way.</h2>
        <p>We'll look at your brand ourselves and email your audit within five working days. If anything's urgent, write to {SITE.email}.</p>
        <a class="btn ghost" href="/">Back to the homepage</a>
      </div>
    </section>
  </article>
</Base>

<script is:inline define:vars={{ Q }}>
(() => {
  const AREA = { story: 'Story', brand: 'Brand', content: 'Content' };
  const $ = (s) => document.querySelector(s);
  const ans = {};
  const bar = $('#bc-bar'), count = $('#bc-count'), left = $('#bc-left'), show = $('#bc-show');
  const update = () => {
    const n = Object.keys(ans).length;
    bar.style.width = n * 10 + '%';
    count.textContent = n + ' of 10 answered';
    left.textContent = n === 10 ? 'All ten answered.' : (10 - n) + ' to go. Answer all ten to see your score.';
    show.setAttribute('aria-disabled', n === 10 ? 'false' : 'true');
    document.querySelectorAll('.q').forEach((f) => f.classList.toggle('done', f.dataset.q in ans));
  };
  document.querySelectorAll('.q input').forEach((r) => r.addEventListener('change', () => {
    ans[r.closest('.q').dataset.q] = Number(r.value); update();
  }));
  show.addEventListener('click', () => {
    if (Object.keys(ans).length < 10) return;
    const score = Object.values(ans).reduce((a, b) => a + b, 0);
    const band = score >= 16 ? ['Strong foundations', 'Your brand is working. The gains now come from consistency and a plan: keep the rhythm, keep measuring, and keep the photos fresh.']
      : score >= 9 ? ['Good, but leaking', "People like you once they find you, but the brand isn't doing enough of the work. Fix your zeros first. They're usually quick wins."]
      : ['Time for a proper look', 'Customers are probably getting mixed messages. Start with questions 1 and 3: get the story and the look right, and the rest gets easier.'];
    $('#bc-score').textContent = score;
    $('#bc-band').textContent = band[0];
    $('#bc-band-text').textContent = band[1];
    Object.keys(AREA).forEach((k) => {
      const idx = Q.map((q, i) => (q.area === k ? i : -1)).filter((i) => i > -1);
      const got = idx.reduce((s, i) => s + ans[i], 0), max = idx.length * 2;
      document.querySelector(`[data-area-val="${k}"]`).textContent = got + ' / ' + max;
      document.querySelector(`[data-area-bar="${k}"]`).style.width = Math.round((got / max) * 100) + '%';
    });
    const list = $('#bc-fixes'); list.textContent = '';
    const order = Q.map((_, i) => i).filter((i) => ans[i] < 2).sort((a, b) => ans[a] - ans[b] || a - b);
    order.forEach((i) => {
      const li = document.createElement('li');
      li.innerHTML = '<span class="n"></span><div><b></b><p></p></div><small></small>';
      li.querySelector('.n').textContent = String(i + 1).padStart(2, '0');
      li.querySelector('b').textContent = Q[i].q;
      li.querySelector('p').textContent = Q[i].fix;
      li.querySelector('small').textContent = (ans[i] === 0 ? 'No · ' : 'Sometimes · ') + AREA[Q[i].area];
      list.appendChild(li);
    });
    $('#bc-fix-intro').textContent = order.length ? 'Your no answers first, then the sometimes. One practical step for each.' : 'No zeros or "sometimes" answers. Your brand is doing its job: keep the rhythm, keep measuring, and keep the photos fresh.';
    $('#bc-chip').textContent = score + ' / 20';
    $('#bc-f-score').value = score + ' / 20 (' + band[0] + ')';
    $('#bc-f-answers').value = Q.map((q, i) => (i + 1) + '. ' + ['No', 'Sometimes', 'Yes'][ans[i]]).join(' | ');
    const res = $('#result'); res.hidden = false;
    res.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  });
  // send the audit request to Netlify Forms without leaving the page
  const form = $('#bc-form');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const btn = form.querySelector('button[type="submit"]'); btn.disabled = true;
    fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(new FormData(form)).toString() })
      .then((r) => { if (!r.ok) throw new Error(); form.hidden = true; $('#bc-thanks').hidden = false; })
      .catch(() => { btn.disabled = false; form.submit(); });
  });
})();
</script>

<style>
  .bc{--blizzard:#8BDAE4;--orange:#FF5B23;--kawaii:#788CE3}
  .d{display:inline-block;width:9px;height:9px;border-radius:50%}
  .d.story{background:var(--blizzard)} .d.brand{background:var(--orange)} .d.content{background:var(--kawaii)}
  .intro{padding-top:clamp(48px,7vw,104px);padding-bottom:40px;display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:48px;align-items:end;border-top:1px solid var(--rule)}
  .intro h1{font-size:clamp(52px,7.4vw,112px);line-height:.9;letter-spacing:-.045em}
  .lede{font-size:clamp(19px,1.8vw,24px);line-height:1.4;max-width:34ch;margin-top:24px}
  .meta{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:22px;font-size:14px;color:var(--mute)}
  .meta span{display:inline-flex;align-items:center;gap:8px}
  .cover{display:block;border-radius:6px;overflow:hidden;box-shadow:10px 10px 0 var(--orange);justify-self:end;width:100%;max-width:220px}
  .cover img{display:block;width:100%;height:auto}
  .prog{position:sticky;top:var(--navh,107px);z-index:5;background:var(--bg);border-bottom:1px solid var(--rule)}
  .prog .wrap{display:flex;align-items:center;gap:18px;padding-top:14px;padding-bottom:14px}
  .bar{flex:1;height:4px;border-radius:2px;background:var(--rule);overflow:hidden}
  .bar span{display:block;width:0;height:100%;background:var(--fg);transition:width .6s var(--ramp)}
  .prog small{font-size:13px;color:var(--mute);white-space:nowrap;font-variant-numeric:tabular-nums}
  .qs{padding-top:24px}
  .q{border:0;margin:0;padding:26px 0;display:grid;grid-template-columns:56px minmax(0,1fr) auto;gap:20px;align-items:center;border-bottom:1px solid var(--rule)}
  .q .n{font-family:var(--display);font-weight:800;font-size:22px;color:var(--mute);font-variant-numeric:tabular-nums}
  .q.done .n{color:var(--fg)}
  .q h2{font-size:22px;line-height:1.2;letter-spacing:-.015em}
  .q h2 .d{margin-left:10px;vertical-align:middle}
  .q p{margin-top:6px;font-size:15px;color:var(--mute);max-width:56ch}
  .opts{display:flex;gap:8px}
  .opt{position:relative;cursor:pointer}
  .opt input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
  .opt span{box-sizing:border-box;min-height:44px;min-width:92px;padding:0 16px;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;box-shadow:inset 0 0 0 1.5px var(--rule);font:600 13px/1 var(--sans);letter-spacing:.06em;transition:background-color .45s var(--ramp),color .45s var(--ramp)}
  .opt:hover span{box-shadow:inset 0 0 0 1.5px var(--mute)}
  .opt input:checked + span{background:var(--fg);color:var(--bg);box-shadow:none}
  .opt input:focus-visible + span{outline:2px solid var(--fg);outline-offset:3px}
  .see{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;padding-top:36px}
  .see p{color:var(--mute);font-size:15px}
  .btn[aria-disabled="true"]{opacity:.35;cursor:default}
  .res{margin-top:72px;padding:clamp(56px,6vw,88px) 0;background:var(--card);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}
  .res .head{display:grid;grid-template-columns:auto minmax(0,1fr);gap:40px;align-items:end}
  .big{font-family:var(--display);font-weight:800;font-size:clamp(88px,11vw,152px);line-height:.85;letter-spacing:-.05em;font-variant-numeric:tabular-nums}
  .big small{font-size:.32em;color:var(--mute);letter-spacing:-.02em;margin-left:6px}
  .band h2{font-size:clamp(32px,3.6vw,48px);line-height:1}
  .band p{margin-top:12px;font-size:18px;max-width:48ch;opacity:.82}
  .areas{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:48px}
  .area{display:grid;gap:10px}
  .area .row{display:flex;justify-content:space-between;font-size:14px;font-weight:600}
  .area .row span:last-child{color:var(--mute);font-variant-numeric:tabular-nums}
  .track{height:8px;border-radius:4px;background:var(--rule);overflow:hidden}
  .track .d{display:block;width:0;height:100%;border-radius:4px;transition:width .8s var(--ramp)}
  .fixes{margin-top:56px}
  .fh{font-size:28px}
  .fixes > p{margin-top:8px;color:var(--mute);font-size:15px}
  .fixes ol{list-style:none;margin:20px 0 0;padding:0;border-top:1px solid var(--rule)}
  .fixes :global(li){display:grid;grid-template-columns:56px minmax(0,1fr) auto;gap:20px;align-items:baseline;padding:20px 0;border-bottom:1px solid var(--rule)}
  .fixes :global(li .n){font-family:var(--display);font-weight:800;font-size:18px;color:var(--mute)}
  .fixes :global(li b){display:block;font-family:var(--display);font-size:18px;font-weight:800}
  .fixes :global(li p){margin-top:4px;font-size:16px;opacity:.82}
  .fixes :global(li small){font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);white-space:nowrap}
  .audit{padding-top:clamp(72px,8vw,120px);padding-bottom:clamp(80px,9vw,140px);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:56px;align-items:start}
  .ah{font-size:clamp(40px,5vw,72px);line-height:.95;max-width:12ch}
  .lead{margin-top:20px;font-size:18px;max-width:40ch;opacity:.82}
  .audit ul{margin:22px 0 0;padding:0;list-style:none;display:grid;gap:10px}
  .audit li{display:grid;grid-template-columns:22px minmax(0,1fr);gap:10px;font-size:16px}
  .audit li::before{content:"";width:12px;height:2px;background:var(--orange);margin-top:12px}
  .pdf{display:flex;gap:10px;align-items:center;margin-top:28px;font-size:14px;color:var(--mute)}
  .pdf a{color:var(--fg);text-underline-offset:3px}
  .form{background:var(--card);border-radius:10px;padding:28px;display:grid;gap:16px;box-shadow:inset 0 0 0 1px var(--rule)}
  .form[hidden]{display:none}
  .two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .form .field input,.form .field textarea{background:var(--bg);color:var(--fg)}
  .form .field label{color:var(--mute)}
  .scorechip{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 16px;border-radius:8px;background:var(--rule);font-size:14px;color:var(--mute)}
  .scorechip b{color:var(--fg);font-family:var(--display);font-size:18px}
  .form small{font-size:12.5px;color:var(--mute)}
  .th{font-size:30px;line-height:1.05}
  .thanks p{opacity:.82}
  .thanks .btn.ghost{justify-self:start}
  @media (max-width:860px){
    .intro{grid-template-columns:minmax(0,1fr)}.cover{justify-self:start;max-width:160px}
    .q{grid-template-columns:40px minmax(0,1fr)}.opts{grid-column:1/-1}.opt{flex:1}.opt span{width:100%;min-width:0}
    .res .head{grid-template-columns:minmax(0,1fr)}.areas{grid-template-columns:minmax(0,1fr)}
    .fixes :global(li){grid-template-columns:40px minmax(0,1fr)}.fixes :global(li small){grid-column:2}
    .audit{grid-template-columns:minmax(0,1fr)}.two{grid-template-columns:minmax(0,1fr)}
  }
  @media (prefers-reduced-motion:reduce){.bar span,.track .d,.opt span{transition:none}}
</style>
